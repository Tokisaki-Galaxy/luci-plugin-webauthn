{
	"luci-app-webauthn": {
		"description": "Grant access to WebAuthn passkey management",
		"read": {
			"ubus": {
				"luci.webauthn": [
					"manage_list",
					"health"
				]
			},
			"uci": [ "luci_plugins" ]
		},
		"write": {
			"uci": [ "luci_plugins" ],
			"ubus": {
				"luci.webauthn": [
					"register_begin",
					"register_finish",
					"manage_delete",
					"manage_update"
				]
			}
		}
	},

	"unauthenticated": {
		"description": "Allow unauthenticated WebAuthn login challenges",
		"read": {
			"ubus": {
				"luci.webauthn": [
					"auth_challenge",
					"login_begin"
				]
			}
		}
	}
}
